# Paykit Server environment. Secrets are supplied only through the
# environment; everything else lives in the TOML file named by PAYKIT_CONFIG
# (see config/paykit-server.example.toml, including the optional [marketplace]
# trusted request-signing keys).

# Path to the server TOML configuration.
PAYKIT_CONFIG=config/paykit-server.toml

# Runtime PostgreSQL connection string. Production's migration-0024 transition
# temporarily retains the owner login; see docs/production-rehearsal.md before
# changing it to a restricted LOGIN member.
PAYKIT_DATABASE_URL=postgres://user:password@localhost:5432/paykit

# Dedicated migration-owner PostgreSQL connection string.
PAYKIT_MIGRATOR_DATABASE_URL=postgres://owner:password@localhost:5432/paykit

# Unpadded base64url encoding of exactly 32 bytes.
PAYKIT_MASTER_KEY=<base64url-32-bytes>
